# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/recruiter-system
USE_MEMORY_DB=true

# Seed defaults
SEED_SUPERADMIN_EMAIL=superadmin@hireflow.app
SEED_SUPERADMIN_PASSWORD=SuperAdmin123!

# AWS S3 (resume + recording uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Gmail / Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# SMTP fallback (used when Gmail OAuth is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HireFlow <noreply@hireflow.app>"

# Calendly
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#hiring

# Security notes
# - Login/register/webhooks use in-memory rate limiting per instance
# - Set CALENDLY_WEBHOOK_SIGNING_KEY in production
# - Set a strong JWT_SECRET and USE_MEMORY_DB=false with a real MONGODB_URI
